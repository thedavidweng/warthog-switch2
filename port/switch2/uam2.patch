diff --git a/source/runtime.c b/source/runtime.c
index ded60b2..dd78a29 100644
--- a/source/runtime.c
+++ b/source/runtime.c
@@ -45,3 +45,27 @@ void* uam2rt_compile_spirv(const uint32_t* words, size_t num_words, Uam2rtStage
 		free(log.buf);
 	return dksh;
 }
+
+void* uam2rt_compile_glsl(const char* source, Uam2rtStage stage,
+	size_t* out_size, char** out_log)
+{
+	struct uam2_log log = { 0 };
+	struct uam2_program prog;
+	void* dksh = NULL;
+	pthread_mutex_lock(&s_lock);
+	bool ok = uam2_compile_glsl(source, (enum uam2_stage)stage, false, &prog, &log);
+	pthread_mutex_unlock(&s_lock);
+	if (ok)
+	{
+		dksh = uam2_build_dksh(&prog, out_size);
+		if (!dksh)
+			uam2_logf(&log, "error: out of memory\n");
+		uam2_program_free(&prog);
+	}
+
+	if (out_log)
+		*out_log = log.buf;
+	else
+		free(log.buf);
+	return dksh;
+}
diff --git a/cross/rust/build-std-sysroot.sh b/cross/rust/build-std-sysroot.sh
