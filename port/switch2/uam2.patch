--- a/cross/rust/build-std-sysroot.sh
+++ b/cross/rust/build-std-sysroot.sh
@@ -34,8 +34,9 @@ TOML
 rust_sysroot="$(rustc --print sysroot)"
 rm -rf "$sysroot"
 mkdir -p "$sysroot/lib/rustlib/$tgt/lib"
-cp "$work/target/$tgt/release/deps/"*.rlib "$work/target/$tgt/release/deps/"*.rmeta \
-	"$sysroot/lib/rustlib/$tgt/lib/"
+find "$work/target/$tgt/release" \( -path '*/deps/*' -o -path '*/build/*/out/*' \) \
+	\( -name '*.rlib' -o -name '*.rmeta' \) ! -name 'libuam2rt_std*' \
+	-exec cp {} "$sysroot/lib/rustlib/$tgt/lib/" +
 for d in "$rust_sysroot/lib/rustlib/"*/; do
 	b="$(basename "$d")"
 	[ "$b" = "$tgt" ] || [ -e "$sysroot/lib/rustlib/$b" ] || ln -s "$d" "$sysroot/lib/rustlib/$b"
